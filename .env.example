# Copy to .env and fill in. The server reads these; they never reach the browser.

# Anthropic credentials. If you've run `ant auth login`, you can leave this unset
# and the SDK will use your profile automatically.
ANTHROPIC_API_KEY=

# Model + ports (optional overrides)
STYLEFIT_MODEL=claude-opus-5
API_PORT=8787

# Product image provider. Default "svg" draws offline garment illustrations.
# Set to a generative provider id (e.g. "openai") after you register one in
# server/images/index.ts — see server/images/generativeProvider.example.ts.
STYLEFIT_IMAGE_PROVIDER=svg
# OPENAI_API_KEY=   # only if you enable the OpenAI image provider
